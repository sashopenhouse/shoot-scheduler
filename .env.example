# Copy this file to .env and fill in your Connecteam API key.
# Same key used by the mapro project (Connecteam Operations Hub, Expert plan).
CONNECTEAM_API_KEY=
CONNECTEAM_BASE_URL=https://api.connecteam.com

# Pin to the install scheduler (Job Scheduling > Installation). This account has
# several schedulers, including archived "Job Scheduler" duplicates and
# "Bathroom Installation" — 673058 (" Installation") is the active install one.
# Leave blank to auto-use the first scheduler returned by the API.
CONNECTEAM_SCHEDULER_ID=673058

# HTTP Basic Auth password protecting the whole app.
SCHEDULER_PASSWORD=

# Supabase project "shoot-scheduler". Server-only — the service_role key
# bypasses Row Level Security, so it must never reach the browser or be
# committed to git. Set these as Vercel environment variables, not just here.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Dropbox app. Server-only — used to mint short-lived access tokens from the
# long-lived refresh token, so uploads never expire. Create the app at
# https://www.dropbox.com/developers/apps with files.content.write,
# files.content.read, and sharing.write scopes, then get a refresh token via
# the OAuth2 authorization-code flow (not the short-lived "Generated access
# token" button, which expires in ~4 hours).
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
